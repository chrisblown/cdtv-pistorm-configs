# Never commit ROMs, disk images, kernels, firmware, overlays, or Amiga-side drivers.
*.rom
*.ROM
*.img
*.hdf
*.adf
*.iso
*.card
*.bin
*.elf
*.dtb
*.dtbo
*.gz
*.xz
*.zip
*.7z

# Emu68 boot assets can be extensionless; profiles contain only their metadata.
roms/
ROMS/
kernel/
KERNEL/
overlays/
Emu68-*

# macOS metadata
.DS_Store
._*

# Local restore backups
backups/
